{
  "$defs": {
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "walk",
            "action",
            "note",
            "movement",
            "environment",
            "coverage"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "source_ids"
      ],
      "title": "Fact",
      "type": "object"
    },
    "RouteRange": {
      "additionalProperties": false,
      "properties": {
        "start_m": {
          "minimum": 0,
          "title": "Start M",
          "type": "number"
        },
        "end_m": {
          "minimum": 0,
          "title": "End M",
          "type": "number"
        },
        "block_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Block Id"
        }
      },
      "required": [
        "start_m",
        "end_m",
        "block_id"
      ],
      "title": "RouteRange",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "items": {
            "enum": [
              "session_boundary",
              "action",
              "note",
              "profile_change",
              "session_speed",
              "distance_fill",
              "observation_gap"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Facts",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "revision",
        "started_at",
        "ended_at",
        "route",
        "reasons",
        "title",
        "facts",
        "sources"
      ],
      "title": "Scene",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "status": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Captured At"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "id",
        "provider",
        "status",
        "captured_at",
        "url"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "walk-storyboard-candidates-v1",
      "default": "walk-storyboard-candidates-v1",
      "title": "Format",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "source_revision": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "maxItems": 250,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    }
  },
  "required": [
    "session_id",
    "source_revision",
    "synthetic",
    "scenes"
  ],
  "title": "StoryboardBundle",
  "type": "object"
}